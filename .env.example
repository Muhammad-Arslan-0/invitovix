# Invitovix Supabase Configuration
# Replace the anon key from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://szwirgptjptqrtdgaqbi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Canonical Production Domain (REQUIRED for SEO sitemap.xml, robots.txt, canonical tags & Open Graph)
# Set to your live HTTPS domain in production, e.g. https://invitovix.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Search Console Verification Tokens (meta tag verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

